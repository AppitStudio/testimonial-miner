# TypeSafe API key (https://console.typesafe.ai/)
API_KEY=apik_...

# Gmail mailboxes to scan. Use a 16-character Google *app password* for each
# (Google Account → Security → 2-Step Verification → App passwords).
GMAIL_1_EMAIL=you@gmail.com
GMAIL_1_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_2_EMAIL=you@yourdomain.com
GMAIL_2_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: other addresses you send from (aliases, support@...). Mail *from* these is skipped.
OWN_EMAILS=

# Optional overrides
SINCE_DATE=2025-03-01
TYPESAFE_MODEL=jev-latest
DATA_DIR=./data
